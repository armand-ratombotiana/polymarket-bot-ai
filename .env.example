# ===== Frontend (Next.js) =====
# API token for backend authentication (generate a strong random string)
NEXT_PUBLIC_API_TOKEN=your-api-token-here

# ===== Backend (FastAPI) =====
# Trading mode: "paper" (default, safe) or "live" (requires safety gate)
TRADING_MODE=paper
# Enable paper trading simulation
PAPER_TRADE=true
# Enable live trading (requires 10-check safety gate to pass)
LIVE_TRADING_ENABLED=false

# API authentication token (must match frontend NEXT_PUBLIC_API_TOKEN)
API_TOKEN=your-api-token-here

# CORS origins (comma-separated, or * for all)
CORS_ORIGINS=*

# ===== Signal Trader =====
SIGNAL_ENABLED=false
SIGNAL_MIN_CONFIDENCE=0.50

# ===== Risk Limits =====
MAX_OPEN_ORDERS=8
MAX_POSITION_PER_MARKET_USDC=3.0
MAX_TOTAL_EXPOSURE_USDC=25.0
DAILY_LOSS_LIMIT_USDC=2.0

# ===== Market Maker =====
MM_ENABLED=true
MM_SPREAD_BPS=200
MM_QUOTE_SIZE_USDC=1.5
MM_MAX_INVENTORY_USDC=15.0

# ===== Arbitrage =====
ARB_ENABLED=true
ARB_MIN_PROFIT_BPS=50
ARB_SCAN_INTERVAL_SECONDS=15
ARB_ORDER_SIZE_USDC=1.5

# ===== UI =====
DASHBOARD_REFRESH_MS=500

# ===== Data Paths (optional — defaults shown) =====
# AUDIT_DB_PATH=/app/data/audit_trail.db
# DECISION_LEDGER_DB_PATH=/app/data/decision_ledger.db
# EXECUTION_QUALITY_DB_PATH=/app/data/execution_quality.db
# OBSERVABILITY_DB_PATH=/app/data/observability.db
# CLOSED_POSITIONS_DB_PATH=/app/data/closed_positions.db
# MARKET_DB_PATH=/app/data/market.db
# MODEL_PATH=/app/data/model.pkl
# MODEL_REGISTRY_PATH=/app/data/model_registry.json
# VECTOR_STORE_PATH=/app/data/vector_store.npz
# STORE_STATE_PATH=/app/data/store_state.json
# KILL_SWITCH_PATH=/app/data/kill_switch.json
# ALERT_DB_PATH=/app/data/alerts.db
