# ─────────────────────────────────────────────
# POLYMARKET BOT — CONFIGURATION
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── Wallet ──────────────────────────────────
# Your Polygon wallet private key (hex, with or without 0x prefix)
POLY_PRIVATE_KEY=your_wallet_private_key_here

# ── CLOB API Credentials ─────────────────────
# Generated automatically on first run via L1 auth.
# Leave blank to auto-derive from private key.
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# ── Network ──────────────────────────────────
POLY_CHAIN_ID=137
POLY_CLOB_HOST=https://clob.polymarket.com
POLY_GAMMA_HOST=https://gamma-api.polymarket.com
POLY_DATA_HOST=https://data-api.polymarket.com
POLY_WS_HOST=wss://ws-subscriptions-clob.polymarket.com/ws/

# ── Mode ─────────────────────────────────────
# Set to true to simulate all orders without sending real money
PAPER_TRADE=true

# ── Risk Management ───────────────────────────
MAX_OPEN_ORDERS=20
MAX_POSITION_PER_MARKET_USDC=100.0
MAX_TOTAL_EXPOSURE_USDC=500.0
DAILY_LOSS_LIMIT_USDC=50.0

# ── Market Making Strategy ────────────────────
MM_ENABLED=true
# Comma-separated list of market token IDs to make markets on (leave blank = auto-select top volume)
MM_MARKET_TOKEN_IDS=
MM_SPREAD_BPS=200
MM_QUOTE_SIZE_USDC=10.0
MM_MAX_INVENTORY_USDC=100.0

# ── Combinatorial Arbitrage Strategy ─────────
ARB_ENABLED=true
ARB_MIN_PROFIT_BPS=50
ARB_SCAN_INTERVAL_SECONDS=30
ARB_ORDER_SIZE_USDC=20.0

# ── Signal-Driven Strategy ───────────────────
SIGNAL_ENABLED=false
SIGNAL_MIN_CONFIDENCE=0.65
SIGNAL_ORDER_SIZE_USDC=10.0

# ── Dashboard ────────────────────────────────
DASHBOARD_REFRESH_MS=500
LOG_LEVEL=INFO
