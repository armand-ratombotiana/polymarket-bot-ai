{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Polymarket Bot — operational dashboard backed by the /metrics Prometheus endpoint (W13-1). Surfaces HTTP request rate / latency / error rate, paper-trading P&L, open positions, ML drift / Brier score, cache hit rate, and active alerts by severity.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "HTTP Request Rate (req/s)",
      "description": "Requests per second summed across all (method, endpoint, status) label combinations. A sustained drop to ~0 indicates the bot stopped serving traffic; a 5x+ spike over baseline suggests a scraper / load-test / DoS.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(polymarket_http_requests_total[1m]))",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "title": "HTTP Latency (p50 / p95 / p99)",
      "description": "Request latency percentiles computed from the polymarket_http_request_duration_seconds histogram. p95 < 100ms is the dashboard SLO; p99 < 500ms is the alert threshold.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(polymarket_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(polymarket_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(polymarket_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5 }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "title": "Error Rate (4xx / 5xx %)",
      "description": "Percentage of requests returning 4xx (client errors — usually auth failures or validation errors) or 5xx (server errors — unhandled exceptions). Alert when 5xx > 1% sustained for 5 minutes.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "100 * sum(rate(polymarket_http_requests_total{status=~\"4..\"}[5m])) / sum(rate(polymarket_http_requests_total[5m]))",
          "legendFormat": "4xx %",
          "refId": "A"
        },
        {
          "expr": "100 * sum(rate(polymarket_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(polymarket_http_requests_total[5m]))",
          "legendFormat": "5xx %",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "title": "Paper Balance ($)",
      "description": "Current paper-trading virtual balance. Starts at $100 (BANKROLL_BASELINE); drops on fills, grows on profitable closes. Alert when below $50 (50% drawdown) — kill switch should already have fired.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "polymarket_paper_balance_usd",
          "legendFormat": "balance",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15 }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "title": "Realized + Unrealized P&L ($)",
      "description": "Realized P&L (closed-trade cumulative profit/loss) and unrealized P&L (mark-to-mid on open positions). Realized should monotonically grow in a healthy bot; unrealized oscillates with the order-book mid.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "polymarket_realized_pnl_usd",
          "legendFormat": "realized",
          "refId": "A"
        },
        {
          "expr": "polymarket_unrealized_pnl_usd",
          "legendFormat": "unrealized",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5 }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "title": "Open Positions Count",
      "description": "Number of open positions currently held. Should track the strategy's target inventory (e.g. MM Stoikov typically 1-5; arb scanner 0-2). A sustained 0 indicates the bot isn't filling; >20 suggests risk-engine limits are too loose.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "expr": "polymarket_open_positions",
          "legendFormat": "positions",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 1 },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "title": "ML Drift PSI (threshold = 0.25)",
      "description": "Population Stability Index for the ML model's feature distribution. <0.10 = no drift; 0.10-0.25 = mild drift (retrain soon); >0.25 = significant drift (retrain immediately — model accuracy degraded).",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "polymarket_ml_drift_psi",
          "legendFormat": "psi",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.10 },
              { "color": "red", "value": 0.25 }
            ]
          }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" },
        "thresholdsStyle": { "mode": "line" }
      }
    },
    {
      "title": "ML Brier Score",
      "description": "Brier score for the ML model's probability predictions. 0.0 = perfect; 0.25 = random-chance binary classifier. Production threshold: < 0.20 (i.e. model is meaningfully better than random).",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "targets": [
        {
          "expr": "polymarket_ml_brier_score",
          "legendFormat": "brier",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.20 },
              { "color": "red", "value": 0.25 }
            ]
          }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" },
        "thresholdsStyle": { "mode": "line" }
      }
    },
    {
      "title": "Cache Hit Rate (%)",
      "description": "Aggregate cache hit rate across all six TTLCache singletons (markets / ml_metrics / analytics / attribution / observability / general). >80% healthy; <50% suggests cache TTLs are too short for the dashboard polling cadence.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "targets": [
        {
          "expr": "100 * sum(rate(polymarket_cache_hits_total[5m])) / (sum(rate(polymarket_cache_hits_total[5m])) + sum(rate(polymarket_cache_misses_total[5m])))",
          "legendFormat": "hit %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 80 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "title": "Active Alerts by Severity",
      "description": "Unacknowledged alert count broken down by severity (info / warning / critical). A sustained >0 critical count means the operator dashboard needs attention (kill switch pending, drawdown, or ML drift breached).",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "polymarket_alerts_active",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["polymarket", "trading-bot", "w13-1"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
