# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Polymarket-bot data files (runtime-generated, not source)
mini-services/polymarket-bot/data/*.db
mini-services/polymarket-bot/data/*.db-*
mini-services/polymarket-bot/data/*.pkl
mini-services/polymarket-bot/data/*.json
mini-services/polymarket-bot/data/reports/
mini-services/polymarket-bot/data/test_run/
mini-services/polymarket-bot/server.log
upload/
tool-results/

# Python bytecode caches (defensive — keep stray .pyc out of commits)
__pycache__/
*.pyc
