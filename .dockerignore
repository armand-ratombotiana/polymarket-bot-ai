# ── Build artefacts ──────────────────────────────────────────────────────────
node_modules
.next
out
dist
build
.tsbuildinfo
tsconfig.tsbuildinfo

# ── VCS / metadata ───────────────────────────────────────────────────────────
.git
.gitignore
.gitattributes

# ── Logs & runtime ───────────────────────────────────────────────────────────
*.log
dev.log
server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Local env files (NEVER bake secrets into images) ─────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
# Note: `.env` itself is intentionally excluded; compose injects via `env_file`.

# ── Backend service artefacts (kept out of the frontend context) ─────────────
mini-services/polymarket-bot/data
mini-services/polymarket-bot/__pycache__
mini-services/polymarket-bot/**/__pycache__
mini-services/polymarket-bot/*.pyc
mini-services/polymarket-bot/tests
mini-services/polymarket-bot/.pytest_cache

# ── Sandboxes, docs, scratch dirs ─────────────────────────────────────────────
docs
agent-ctx
tool-results
skills
download
upload
tests
vitest.config.ts

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.vscode
.idea
.DS_Store
Thumbs.db

# ── Docker / Compose (don't ship compose inside images) ──────────────────────
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml
Caddyfile
Caddyfile.prod

# ── Misc project files not needed at runtime ─────────────────────────────────
README.md
CONTRIBUTING.md
*.md
